GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPOSITORY=owner/repository
WORKSPACE_PATH=/absolute/path/to/local/repository

# Optional settings
ISSUE_SOURCE=webhook
POLL_INTERVAL_SECONDS=15
LLM_MODEL=gemini/gemini-3.6-flash
LLM_FALLBACK_MODEL=groq/openai/gpt-oss-120b
LLM_RETRIES=2
# Local LiteLLM provider example:
# LLM_MODEL=ollama/qwen2.5-coder
# LLM_API_BASE=http://localhost:11434
BASE_BRANCH=main
MAX_TURNS=3
TURN_DELAY_SECONDS=4.1
REQUIRED_ISSUE_LABEL=ai-fix
ALLOWED_AUTHOR_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
PUBLISH_ENABLED=false
FETCH_BEFORE_RUN=true
REQUIRE_VERIFICATION=true
KEEP_FAILED_WORKTREE=false
WORKTREE_ROOT=/tmp/issue-to-pr-agent/worktrees
STATE_DB_PATH=.state/jobs.sqlite3
