GEMINI_API_KEY=
GROQ_API_KEY=
# Recommended: GitHub App credentials. Keep the PEM outside the repository.
GITHUB_AUTH_MODE=app
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/host/path/to/github-app.pem
# Legacy token mode only. Must be empty when GITHUB_AUTH_MODE=app.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPOSITORY=owner/repository
WORKSPACE_PATH=/absolute/path/to/local/repository

# Optional settings
ISSUE_SOURCE=webhook
POLL_INTERVAL_SECONDS=15
LLM_MODEL=gemini/gemini-3.1-pro-preview
LLM_FALLBACK_MODEL=
LLM_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
MAX_TOTAL_TOKENS_PER_JOB=30000
MAX_ESTIMATED_COST_USD=0.50
MODEL_INPUT_COST_PER_MILLION_USD=2.0
MODEL_OUTPUT_COST_PER_MILLION_USD=12.0
REQUIRE_USAGE_ACCOUNTING=true
# Local LiteLLM provider example:
# LLM_MODEL=ollama/qwen2.5-coder
# LLM_API_BASE=http://localhost:11434
BASE_BRANCH=main
MAX_TURNS=3
TURN_DELAY_SECONDS=4.1
REQUIRED_ISSUE_LABEL=ai-fix
ALLOWED_AUTHOR_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
PUBLISH_ENABLED=false
GITHUB_EXPECTED_LOGIN=
GIT_AUTHOR_NAME=Issue-to-PR Agent
GIT_AUTHOR_EMAIL=issue-to-pr-agent@users.noreply.github.com
FETCH_BEFORE_RUN=true
ALLOW_LOCAL_GIT_ORIGIN=false
REQUIRE_VERIFICATION=true
REQUIRE_FAIL_TO_PASS=true
MAX_CORRECTION_CYCLES=1
REQUIRED_VERIFICATION_COMMANDS=[["python","-m","unittest","discover","-s","tests","-v"]]
VERIFICATION_BACKEND=docker
VERIFICATION_CONTAINER_IMAGE=python:3.13-slim
VERIFICATION_RUNNER_QUEUE_PATH=/runner-queue
VERIFICATION_RUNNER_POLL_SECONDS=0.1
ALLOW_HOST_VERIFICATION=false
VERIFICATION_TIMEOUT_SECONDS=120
JOB_TIMEOUT_SECONDS=600
WORKER_SHUTDOWN_TIMEOUT_SECONDS=20
MAX_CHANGED_FILES=8
MAX_DIFF_LINES=800
LOCALIZATION_MAX_FILES=5
LOCALIZATION_TREE_ENTRIES=200
LOCALIZATION_MAX_CONTEXT_CHARS=12000
KEEP_FAILED_WORKTREE=false
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_SECONDS=10
REPOSITORY_MIRROR_PATH=
ISSUE_TO_PR_RUNTIME_PATH=/absolute/host/path/to/issue-to-pr-runtime
WORKTREE_ROOT=/tmp/issue-to-pr-agent/worktrees
STATE_DB_PATH=.state/jobs.sqlite3
GITHUB_CHECKS_ENABLED=true
