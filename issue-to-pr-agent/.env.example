GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPOSITORY=owner/repository
WORKSPACE_PATH=/absolute/path/to/local/repository

# Optional settings
ISSUE_SOURCE=webhook
POLL_INTERVAL_SECONDS=15
LLM_MODEL=gemini/gemini-3.1-pro-preview
LLM_FALLBACK_MODEL=
LLM_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
# Local LiteLLM provider example:
# LLM_MODEL=ollama/qwen2.5-coder
# LLM_API_BASE=http://localhost:11434
BASE_BRANCH=main
MAX_TURNS=3
TURN_DELAY_SECONDS=4.1
REQUIRED_ISSUE_LABEL=ai-fix
ALLOWED_AUTHOR_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
PUBLISH_ENABLED=false
GITHUB_EXPECTED_LOGIN=
GIT_AUTHOR_NAME=Issue-to-PR Agent
GIT_AUTHOR_EMAIL=issue-to-pr-agent@users.noreply.github.com
FETCH_BEFORE_RUN=true
REQUIRE_VERIFICATION=true
REQUIRED_VERIFICATION_COMMANDS=[["python","-m","unittest","discover","-s","tests","-v"]]
VERIFICATION_BACKEND=docker
VERIFICATION_CONTAINER_IMAGE=python:3.13-slim
ALLOW_HOST_VERIFICATION=false
VERIFICATION_TIMEOUT_SECONDS=120
KEEP_FAILED_WORKTREE=false
JOB_MAX_ATTEMPTS=2
JOB_RETRY_DELAY_SECONDS=10
WORKTREE_ROOT=/tmp/issue-to-pr-agent/worktrees
STATE_DB_PATH=.state/jobs.sqlite3
